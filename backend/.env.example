# Copy this file to ".env" and fill in your API key from
# https://www.last.fm/api/account/create

LASTFM_API_KEY=your_api_key_here

# SQLite file location (relative to backend/). Default is fine.
DATABASE_PATH=snapshots.db

# Comma-separated origins allowed to call this API (the frontend dev server)
CORS_ORIGINS=http://localhost:5173
